# Copier en .env et renseigner. Ne JAMAIS committer le vrai .env.
# Token API Pennylane (Company API Token, Paramètres > Connectivité > Développeurs).
# Plan Essential ou + requis ; rôle Executive/Comptable.
PENNYLANE_API_TOKEN=

# Optionnel : surcharge de l'URL de base de l'API (par défaut API v2 publique).
# PENNYLANE_BASE_URL=https://app.pennylane.com/api/external/v2

# Optionnel : date de début du backlog à analyser (ISO YYYY-MM-DD).
# BACKLOG_SINCE=2025-01-01

# --- Rapprochement UberEats (scripts/run_ubereats.py) ---
# Identifiants du portail UberEats (login email + mot de passe).
UBEREATS_EMAIL=
UBEREATS_PASSWORD=

# API Qonto third-party (Paramètres > Intégrations > API).
# Sert à lister les virements de remboursement et attacher les PDF.
QONTO_ORGANIZATION_SLUG=
QONTO_SECRET_KEY=

# --- Rapprochement factures fournisseurs (scripts/run_fournisseurs.py) ---
# Dossier Google Drive à scanner (nom exact).
DRIVE_FOLDER_NAME=Factures fournisseurs
# Chemins OAuth Google (gitignorés, placer à la racine du projet).
# GOOGLE_CREDENTIALS_PATH=credentials.json   # (défaut)
# GOOGLE_TOKEN_PATH=token.json               # (défaut)

# --- Email rapport hebdo des non-rapprochés (réutilise le Gmail d'orfeo) ---
GMAIL_USER=tonemail@gmail.com
GMAIL_APP_PASSWORD=motdepasse16caracteres
EMAIL_TO=hello@maisondarwish.com
