<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.maisondarwish.chatgpt-chrome</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/naeldarwish/rapprochement-pennylane/scripts/launch_chatgpt_chrome.sh</string>
    </array>
    <!-- Au login + vérif toutes les 30 min : relance le Chrome debug s'il est tombé -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>StandardErrorPath</key>
    <string>/Users/naeldarwish/rapprochement-pennylane/reports/portals/chrome_chatgpt.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key><string>/Users/naeldarwish</string>
    </dict>
</dict>
</plist>
