<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.maisondarwish.fournisseurs-recon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/naeldarwish/rapprochement-pennylane/scripts/run_fournisseurs_weekly.sh</string>
    </array>

    <!-- Mercredi à 9h00 (décalé des autres rapprochements) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>4</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/naeldarwish/rapprochement-pennylane/reports/fournisseurs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/naeldarwish/rapprochement-pennylane/reports/fournisseurs/launchd_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/naeldarwish</string>
    </dict>
</dict>
</plist>
