<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.maisondarwish.weekly-recap</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/naeldarwish/rapprochement-pennylane/scripts/weekly_recap.sh</string>
    </array>

    <!-- Lundi à 9h00 (launchd : 0/7=dimanche, 1=lundi) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Si le Mac était éteint lundi 9h, le wrapper dédupe via .derniere_semaine_email -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/naeldarwish/rapprochement-pennylane/reports/recap/recap_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/naeldarwish/rapprochement-pennylane/reports/recap/recap_stderr.log</string>

    <!-- PATH inclut homebrew : claude (escalade), pdftotext (recherche justificatif) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/naeldarwish/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/naeldarwish</string>
    </dict>
</dict>
</plist>
